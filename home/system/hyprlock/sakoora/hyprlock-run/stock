#!/bin/sh

symbol=${1:-NVDA}
json=$(curl -fsS "https://stockprices.dev/api/stocks/${symbol}" 2>/dev/null) || {
  echo "${symbol}: --"
  exit 0
}

python3 - <<'PY' "$symbol" "$json"
import json
import sys

sym = sys.argv[1]
raw = sys.argv[2]
try:
    data = json.loads(raw)
    price = data.get("Price")
except Exception:
    price = None

if price is None:
    print(f"{sym}: --")
    sys.exit(0)

print(f"{sym} ${price:.2f}")
PY
